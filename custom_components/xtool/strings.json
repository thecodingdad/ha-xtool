  "services": {
    "focus": {
      "name": "Focus",
      "description": "Moves the laser's focus as xTool Studio's manual focus does: by a signed step (repeated a number of times), or straight to a material thickness. Stops at 0 or 150 mm. Refused while a job runs, while the laser focuses or measures, or when it reports an error.",
      "fields": {
        "step": {
          "name": "Step",
          "description": "Signed step in mm: positive moves up, negative moves down."
        },
        "steps": {
          "name": "Steps",
          "description": "How many times to apply the step."
        },
        "thickness": {
          "name": "Thickness",
          "description": "Material thickness to focus on, in mm (0-150), as Studio shows it."
        }
      }
    },
    "move": {
      "name": "Move",
      "description": "Moves the P2's laser head as xTool Studio's move controls do: to an X and Y position, or by signed steps (repeated a number of times). An axis given neither stays where it is. Stops at 0-620 by 0-308 mm. Refused unless the laser is idle. Moves run one at a time, in the order asked.",
      "fields": {
        "x": {
          "name": "X",
          "description": "Position to move to, in mm from home (0-620); X grows to the right."
        },
        "y": {
          "name": "Y",
          "description": "Position to move to, in mm from home (0-308); Y grows toward the front."
        },
        "step_x": {
          "name": "Step X",
          "description": "Signed step in mm: positive moves right, negative moves left."
        },
        "step_y": {
          "name": "Step Y",
          "description": "Signed step in mm: positive moves toward the front, negative toward the back."
        },
        "steps": {
          "name": "Steps",
          "description": "How many times to apply the steps."
        }
      }
    },
    "camera": {
      "name": "Camera crop",
      "description": "Sets the part of the work surface the straightened main camera shows, in mm, and refreshes its picture. Give any of the four values; the others stay. A width or height of 0 shows the whole photo that way.",
      "fields": {
        "crop_width": {
          "name": "Crop width",
          "description": "Width of the area in mm (20-460), or 0 for the whole photo across."
        },
        "crop_height": {
          "name": "Crop height",
          "description": "Height of the area in mm (20-460), or 0 for the whole photo down."
        },
        "crop_center_x": {
          "name": "Crop center X",
          "description": "Center of the area in mm from the center of the calibrated area; positive moves right."
        },
        "crop_center_y": {
          "name": "Crop center Y",
          "description": "Center of the area in mm from the center of the calibrated area; positive moves down."
        }
      }
    }
  },
